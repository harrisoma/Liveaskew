{
  "manifest_version": 3,
  "name": "LiveAskew — Bee",
  "short_name": "Bee",
  "version": "1.0.0",
  "description": "Bee, your LiveAskew stylist, beside every page: ask about a piece while you shop, plan what to wear, and see your day.",
  "homepage_url": "https://www.liveaskew.com",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Open Bee",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" }
  },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["sidePanel", "identity", "storage", "contextMenus"],
  "host_permissions": ["https://www.liveaskew.com/*", "https://liveaskew.vercel.app/*"],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
