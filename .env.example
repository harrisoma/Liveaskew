# Public Supabase configuration
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only Onixus AI tenant connection. Base URL must include /v1.
ONIXUS_AI_BASE_URL=
ONIXUS_AI_API_KEY=
ONIXUS_AI_ORGANIZATION_ID=

# Hosted Bee API origin for Capacitor store builds (no trailing slash).
# Leave empty for `npm run dev` (same-origin). Example: https://app.liveaskew.co
VITE_API_BASE=
CAPACITOR_SERVER_URL=

# n8n virtual try-on webhook (selfie + garment → IDM-VTON-style render)
N8N_TRYON_WEBHOOK_URL=

# n8n wardrobe Reset vision (optional). If unset, /api/wardrobe/analyze uses Onixus vision.
N8N_WARDROBE_WEBHOOK_URL=

# FCM (Capacitor push on iOS and Android). HTTP v1 preferred; legacy server key accepted.
FCM_SERVICE_ACCOUNT_JSON=
FCM_SERVER_KEY=
CRON_SECRET=

# Stripe (direct API — set on the Vercel project). Sandbox for preview/dev, live for production.
STRIPE_SANDBOX_API_KEY=
STRIPE_LIVE_API_KEY=
PAYMENTS_SANDBOX_WEBHOOK_SECRET=
PAYMENTS_LIVE_WEBHOOK_SECRET=

# Buzz social publishing. Register this one callback URL with every network:
#   <PUBLIC_APP_URL>/api/public/buzz/callback
PUBLIC_APP_URL=
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts social tokens at rest.
BUZZ_TOKEN_KEY=
# Meta app (Facebook Login for Business) — Facebook Pages + Instagram professional accounts
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0
# Threads (Threads API use case on a Meta app — it has its own app ID and secret)
THREADS_APP_ID=
THREADS_APP_SECRET=
# LinkedIn app with "Share on LinkedIn" + "Sign In with LinkedIn using OpenID Connect"
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202601
# X developer app, OAuth 2.0, type "Web App" (confidential client)
X_CLIENT_ID=
X_CLIENT_SECRET=
